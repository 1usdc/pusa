# Another-Me-LLM 后端 base URL：被两端共用 —
#   1) claw-rs server：把所有 /v1/* 请求的 Bearer token 转发到上游 /api/cloud/auth/me 校验；
#   2) claw-web nginx：模板里 /llm/ → proxy_pass ${ANOTHERME_BASE_URL}/（envsubst 渲染）。
#
# 取值规则：
#   - `just web`（dx serve 本机直跑）：用 `http://127.0.0.1:8881`，因为 WASM 跑在宿主机浏览器，
#     不在容器里。⚠️ 此场景下不要用 `host.docker.internal`，浏览器解析不了。
#   - `just docker-up`（compose 同机跑 web/server，Another-Me-LLM 也在宿主机）：
#     用 `http://host.docker.internal:8881`，compose 已配 extra_hosts: host-gateway。
#   - 生产（claw-rs 与 Another-Me-LLM 分开部署）：用 Another-Me-LLM 的公网域名 / 内网地址，
#     例如 `https://api.anotherme.co` 或 `http://10.0.0.5:8881`。
ANOTHERME_BASE_URL=http://127.0.0.1:8881
# Another-Me-Relay base URL：claw-web nginx 模板里 /relay/ → proxy_pass ${ANOTHERME_RELAY_BASE_URL}/。
# WASM 在 same-origin-api feature 下调用 {origin}/relay，由前端站点的 nginx 反代到这里，绕开 CORS。
#   - `just web`（本机 dx serve）：默认 https://relay.anotherme.co，按需改成预发 / 本地 Relay。
#   - 生产：填 Relay 的公网域名（默认与示例一致）。
ANOTHERME_RELAY_BASE_URL=https://relay.anotherme.co
# 单请求向上游问询的超时（毫秒）。
ANOTHERME_TIMEOUT_MS=5000
# token 远程校验结果的内存缓存 TTL（秒）：在不牺牲撤销实时性的前提下减少多请求场景下的额外 RTT。
ANOTHERME_AUTH_CACHE_TTL_SECONDS=60
# reown / WalletConnect v2 项目 ID（在 https://cloud.reown.com 注册免费获取）。
# 留空：浏览器只会用注入的 EIP-1193 钱包（MetaMask / Rabby 等）；填上后启用扫码 / 跨设备登录。
REOWN_PROJECT_ID=f337cf05ec3bed79bd5db8f9fd30bf0e
RUST_LOG=info
# 已废弃：reown 模式下 claw-rs server 不再自签 JWT，token 完全由 Another-Me-LLM 颁发。
# AUTH_JWT_SECRET=
