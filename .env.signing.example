# 桌面打包签名凭证（复制为 .env.signing，勿提交）
# cp .env.signing.example .env.signing

# —— macOS（Developer ID + 公证，见 scripts/macos-sign-notarize.sh）——
# MACOS_SIGNING_IDENTITY="Developer ID Application: Your Company (TEAMID)"
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID

# —— Windows（Azure Artifact Signing，见 scripts/windows-sign.ps1）——
# 区域 Endpoint 须与 Portal 里 Trusted Signing 账户一致，例如 East US：
# AZURE_TS_ENDPOINT=https://eus.codesigning.azure.net
# AZURE_TS_ACCOUNT=你的 Artifact Signing 账户名
# AZURE_TS_PROFILE=你的 Certificate Profile 名（如 pusa-default）
#
# 本机认证（二选一）：
#   az login
# 或服务主体（需 Certificate Profile Signer 角色）：
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
#
# 可选：Azure.CodeSigning.Dlib.dll 路径（未装 Client Tools 时手动指定）
# AZURE_SIGNING_DLIB=C:\path\to\x64\Azure.CodeSigning.Dlib.dll
